# Environment (development / staging / production)
ENVIRONMENT=development

# Application name identifier
PROJECT_NAME="Nyaya Legal Assistant"

# API v1 path prefix
API_V1_STR=/api/v1

# Secret key for session security & token signing
SECRET_KEY=dev-secret-key-change-in-production

# PostgreSQL host address
POSTGRES_SERVER=localhost

# PostgreSQL port
POSTGRES_PORT=5432

# PostgreSQL username
POSTGRES_USER=postgres

# PostgreSQL password
POSTGRES_PASSWORD=postgres

# PostgreSQL database name
POSTGRES_DB=nyaya_db

# Redis server host address
REDIS_HOST=localhost

# Redis server port
REDIS_PORT=6379

# Open-source embedding model name from HuggingFace
EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5

# Device to run embedding model on (cpu or cuda)
EMBEDDING_DEVICE=cpu

# Active LLM provider ('gemini' or 'ollama')
LLM_PROVIDER=gemini

# Google Gemini API key for response generation
GEMINI_API_KEY=your_gemini_api_key_here

# Ollama server base URL for local LLM evaluation
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model name for local LLM evaluation
OLLAMA_MODEL=llama3

# Directory path for raw source legal PDFs
DATA_RAW_DIR=./data/raw

# Directory path for extracted statutory form PDFs
DATA_FORMS_DIR=./data/forms
